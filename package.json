{
  "name": "quantumshield",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start:api": "node dist/server.js",
    "dev": "nodemon --watch src --exec \"node --loader ts-node/esm src/server.ts\"",

    "ks:init": "node --loader ts-node/esm src/cli.ts ks:init",
    "ks:add": "node --loader ts-node/esm src/cli.ts ks:add",
    "ks:add:mn": "node --loader ts-node/esm src/cli.ts ks:add:mn",
    "ks:list": "node --loader ts-node/esm src/cli.ts ks:list",
    "ks:show": "node --loader ts-node/esm src/cli.ts ks:show",
    "ks:label": "node --loader ts-node/esm src/cli.ts ks:label",

    "state:init": "node --loader ts-node/esm src/cli.ts state:init",
    "state:fund": "node --loader ts-node/esm src/cli.ts state:fund",
    "state:balance": "node --loader ts-node/esm src/cli.ts state:balance",

    "tx:send": "node --loader ts-node/esm src/cli.ts tx:send",
    "tx:send:enc": "node --loader ts-node/esm src/cli.ts tx:send:enc",
    "tx:get": "node --loader ts-node/esm src/cli.ts tx:get",

    "chain:mine": "node --loader ts-node/esm src/cli.ts chain:mine",
    "chain:tip": "node --loader ts-node/esm src/cli.ts chain:tip",
    "addr:txs": "node --loader ts-node/esm src/cli.ts addr:txs",

    "contacts:add": "node --loader ts-node/esm src/cli.ts contacts:add",
    "contacts:list": "node --loader ts-node/esm src/cli.ts contacts:list",
    "kem:pub": "node --loader ts-node/esm src/cli.ts kem:pub",

    "api": "nodemon --watch src --exec \"node --loader ts-node/esm src/server.ts\"",
    "build:js": "tsc"
  }
}
