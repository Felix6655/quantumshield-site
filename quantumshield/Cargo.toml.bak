[package]
name = "quantumshield"
version = "0.1.0"
edition = "2021"
autobins = false

[[bin]]
name = "qs"
path = "src/main.rs"

[dependencies]
axum = "0.8.4"
base64 = "0.22.1"
pqcrypto-dilithium = "0.5.0"
pqcrypto-kyber = "0.8.1"
serde = { version = "1.0.226", features = ["derive"] }
serde_json = "1.0.145"
tokio = { version = "1.47.1", features = ["full"] }

[[bin]]
name = "qs-node"
path = "src/bin/qs-node.rs"


[[bin]]
name = "qs"
path = "src/main.rs"

